# Copy this file to .env. The server automatically loads it.
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/modern-risk.sqlite
# Live AI: create a key in Google AI Studio and paste it ONLY in your local .env.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# For other devices on your Wi-Fi, set HOST=0.0.0.0.
# Optional alternative: set AI_PROVIDER=openai and configure both values below.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Never commit keys or place them in browser files. .env is ignored by Git.
